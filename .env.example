BASE_PATH=/api

# Локальный MongoDB для разработки (например, поднятый в Docker: docker run -d --name bloggers-mongo -p 27017:27017 -v bloggers-mongo-data:/data/db mongo:7)
MONGO_PATH=mongodb://0.0.0.0:27017/bloggers-dev-db
MONGO_DB_NAME=bloggers-dev-db

# Продакшн (MongoDB Atlas) — реальные значения задаются в Vercel Dashboard → Settings → Environment Variables, не здесь
MONGO_PATH_PROD=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app-name>
MONGO_DB_NAME_PROD=Bloggers

#PEPPER - секрет должен быть 64 hex-символа (32 байта)
PEPPER=dsar547fds8d8vxc87gds876f77c8v7x78cv6zx78v68cx7v

# JWT_SECRET - base64url-строка (32 байта), например: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=BbXuoc-Ops4skdVoWuQwg40Kfs5jVj7989UA_WU6Hlk
# JWE_KEYS - node -e "const c=require('crypto');console.log(new Date().toISOString().slice(0,7)+':'+c.randomBytes(32).toString('base64url'))" # 2026-10:Xq3v...
JWE_KEYS=2026-11:key-1,2026-10:key-2
#креды для SMTP
SMTP_USER=example@gmail.com
SMTP_PASS=example-password
